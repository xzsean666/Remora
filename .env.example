# ==============================================================================
# Remora Environment Variables Template
# Copy to .env and fill in your custom values if needed.
# ==============================================================================

# Android Release Keystore Configuration
# (Generates consistent APK signatures for seamless in-place updates)
ANDROID_KEYSTORE_PATH=./remora-release.keystore
ANDROID_KEY_ALIAS=remora
ANDROID_KEYSTORE_PASSWORD=your_keystore_password_here
ANDROID_KEY_PASSWORD=your_key_password_here

# Base64-encoded keystore for CI/CD environments (GitHub Actions)
ANDROID_KEYSTORE_BASE64=

# ==============================================================================
# AI Commit Generator Configuration
# Supports self-hosted OpenAI-compatible models (Ollama, vLLM, etc.) and OpenRouter
# ==============================================================================

# Option 1: Self-hosted / OpenAI-compatible endpoint (Default)
AI_API_KEY=your_api_key_here
AI_BASE_URL=http://127.0.0.1/v1
AI_MODEL=qwen3.5:2b-optimized

# Option 2: OpenRouter (Legacy / Cloud fallback)
# OPEN_ROUTER_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=nvidia/nemotron-3.5-lightning:free
