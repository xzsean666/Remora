# ==============================================================================
# Remora Environment Variables Template
# Copy to .env and fill in your custom values if needed.
# ==============================================================================

# Android Release Keystore Configuration
# (Generates consistent APK signatures for seamless in-place updates)
ANDROID_KEYSTORE_PATH=./remora-release.keystore
ANDROID_KEY_ALIAS=remora
ANDROID_KEYSTORE_PASSWORD=your_keystore_password_here
ANDROID_KEY_PASSWORD=your_key_password_here

# Base64-encoded keystore for CI/CD environments (GitHub Actions)
ANDROID_KEYSTORE_BASE64=
